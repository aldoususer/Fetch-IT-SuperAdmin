# Use the separate restricted owner-runtime PostgreSQL login, not the migration owner.
DATABASE_URL=postgresql://fetch_owner_runtime:REPLACE_ME@YOUR_NEON_HOST/neondb?sslmode=require
# Exact origin; no trailing slash. Production requires HTTPS.
SUPERADMIN_URL=http://localhost:3003
# At least 32 random characters; independent of customer/rider/staff secrets.
SESSION_SECRET=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Set only when running maintenance/bootstrap, not as a Vercel runtime variable.
# OWNER_MAINTENANCE_DATABASE_URL=postgresql://...

# ePOD photos: use the SAME PRIVATE Vercel Blob store in all Fetch apps.
# Connected Vercel projects use OIDC with this store ID.
BLOB_STORE_ID=
# Local development or cross-account fallback; server-only, never NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=
